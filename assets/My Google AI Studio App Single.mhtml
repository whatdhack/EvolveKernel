import triton.language as tl

@triton.jit
def relu_kernel(
    x_ptr,
    y_ptr,
    n_elements,
    BLOCK_SIZE: tl.constexpr,
):
    pid =3D tl.program_id(axis=3D0)
    block_start =3D pid * BLOCK_SIZE
    offsets =3D block_start + tl.arange(0, BLOCK_SIZE)
    mask =3D offsets &lt; n_elements
    x =3D tl.load(x_ptr + offsets, mask=3Dmask)
    y =3D tl.where(x &gt; 0.0, x, 0.0)
    tl.store(y_ptr + offsets, y, mask=3Dmask)
